                  "type": "string"
                },
                {
                  "format": "uuid"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests admitted at once.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests admitted now.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until RateLimit-Limit requests are admitted again.",
