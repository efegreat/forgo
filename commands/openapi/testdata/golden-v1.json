{
  "openapi": "3.1.0",
  "info": {
    "title": "Shop API",
    "description": "The shop.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "paths": {
    "/v1/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "type": "string"
                },
                {
                  "format": "uuid"
                }
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "allOf": [
                {
                  "type": "integer"
                },
                {
                  "minimum": 1
                }
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "enum": [
                "open",
                "paid"
              ],
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "reqId": {
                      "type": "string"
                    },
                    "result": {
                      "$ref": "#/components/schemas/pageOfGoldenItem"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "errCode": {
                      "type": "string"
                    },
                    "errMsg": {
                      "type": "string"
                    },
                    "reqId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createItem",
        "description": "Creates an item.",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Also accepted as the body property \"locale\". When a request sends several, this one wins.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "type": "string"
                },
                {
                  "format": "uuid"
                }
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "item": {
                    "$ref": "#/components/schemas/goldenItemRequest"
                  },
                  "locale": {
                    "description": "Also accepted as the header \"Accept-Language\". When a request sends several, the header \"Accept-Language\" wins.",
                    "type": "string"
                  },
                  "name": {
                    "allOf": [
                      {
                        "type": "string"
                      },
                      {
                        "maxLength": 64,
                        "minLength": 2
                      }
                    ]
                  },
                  "parent": {
                    "allOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "format": "uuid"
                      }
                    ]
                  },
                  "price": {
                    "format": "decimal",
                    "type": "string"
                  },
                  "tags": {
                    "allOf": [
                      {
                        "anyOf": [
                          {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "maxItems": 10
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "price"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "reqId": {
                      "type": "string"
                    },
                    "result": {
                      "$ref": "#/components/schemas/goldenItem"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "errCode": {
                      "type": "string"
                    },
                    "errMsg": {
                      "type": "string"
                    },
                    "reqId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/items/{id}": {
      "get": {
        "operationId": "getItem",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Also accepted as the body property \"locale\" and the query parameter \"locale\". When a request sends several, this one wins.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "type": "string"
                },
                {
                  "format": "uuid"
                }
              ]
            }
          },
          {
            "name": "X-Trace",
            "in": "header",
            "description": "Send one header line per value.",
            "schema": {
              "allOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "maxItems": 3
                }
              ]
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "Also accepted as the body property \"id\". When a request sends several, this one wins.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Also accepted as the body property \"locale\" and the header \"Accept-Language\". When a request sends several, the header \"Accept-Language\" wins.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "id": {
                    "description": "Also accepted as the path parameter \"id\". When a request sends several, the path parameter \"id\" wins.",
                    "type": "string"
                  },
                  "locale": {
                    "description": "Also accepted as the query parameter \"locale\" and the header \"Accept-Language\". When a request sends several, the header \"Accept-Language\" wins.",
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "reqId": {
                      "type": "string"
                    },
                    "result": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/goldenItem"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "errCode": {
                      "type": "string"
                    },
                    "errMsg": {
                      "type": "string"
                    },
                    "reqId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "goldenItem": {
        "properties": {
          "attrs": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/goldenItem"
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "format": "decimal",
            "type": "string"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "createdAt",
          "id",
          "price"
        ],
        "type": "object"
      },
      "goldenItemRequest": {
        "properties": {
          "attrs": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/goldenItemRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "format": "decimal",
            "type": "string"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "pageOfGoldenItem": {
        "properties": {
          "items": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/goldenItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
